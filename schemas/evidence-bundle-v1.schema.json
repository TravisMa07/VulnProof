{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "truncated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Truncated"
        }
      },
      "required": [
        "id",
        "path",
        "media_type"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "confirmed",
            "inconclusive",
            "unsupported",
            "failed"
          ],
          "title": "Classification",
          "type": "string"
        },
        "execution_evidence_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Evidence Id"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "static_evidence_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Static Evidence Id"
        },
        "static_path_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Static Path Id"
        }
      },
      "required": [
        "classification",
        "reasons"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "ExecutionEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Finding Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "image_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Id"
        },
        "oracle": {
          "default": "not_evaluated",
          "enum": [
            "observed",
            "not_observed",
            "not_evaluated"
          ],
          "title": "Oracle",
          "type": "string"
        },
        "oracle_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oracle Id"
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "not_run"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/SourceBinding"
        },
        "static_evidence_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Static Evidence Id"
        },
        "static_path_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Static Path Id"
        }
      },
      "required": [
        "id",
        "finding_id",
        "source",
        "outcome"
      ],
      "title": "ExecutionEvidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "cwes": {
          "default": [],
          "items": {
            "pattern": "^CWE-[1-9][0-9]*$",
            "type": "string"
          },
          "title": "Cwes",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "original_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Ref"
        },
        "rule_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rule Id",
          "type": "string"
        },
        "scanner": {
          "$ref": "#/$defs/ToolIdentity"
        },
        "source": {
          "$ref": "#/$defs/SourceBinding"
        }
      },
      "required": [
        "id",
        "scanner",
        "rule_id",
        "location",
        "source"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Reason",
      "type": "object"
    },
    "SourceBinding": {
      "additionalProperties": false,
      "properties": {
        "expected_snapshot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Expected Snapshot Id",
          "type": "string"
        },
        "observed_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Snapshot Id"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "state": {
          "default": "unverified",
          "enum": [
            "matched",
            "unverified",
            "mismatched"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "expected_snapshot_id",
        "reason"
      ],
      "title": "SourceBinding",
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "SourceFile",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "end_column": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Column"
        },
        "end_line": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "start_column": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Column"
        },
        "start_line": {
          "exclusiveMinimum": 0,
          "title": "Start Line",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line"
      ],
      "title": "SourceLocation",
      "type": "object"
    },
    "SourceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Id"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceFile"
          },
          "title": "Files",
          "type": "array"
        },
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "SourceSnapshot",
      "type": "object"
    },
    "StaticEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "cwe": {
          "anyOf": [
            {
              "pattern": "^CWE-[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwe"
        },
        "finding_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Finding Id",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "path_found",
            "no_path_found",
            "unsupported",
            "failed",
            "not_run"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "paths": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StaticPath"
          },
          "title": "Paths",
          "type": "array"
        },
        "reasons": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "rule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "source": {
          "$ref": "#/$defs/SourceBinding"
        },
        "tool": {
          "$ref": "#/$defs/ToolIdentity"
        }
      },
      "required": [
        "id",
        "finding_id",
        "tool",
        "source",
        "outcome"
      ],
      "title": "StaticEvidence",
      "type": "object"
    },
    "StaticPath": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "minItems": 2,
          "title": "Locations",
          "type": "array"
        }
      },
      "required": [
        "id",
        "locations"
      ],
      "title": "StaticPath",
      "type": "object"
    },
    "ToolIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "rule_pack": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Pack"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolIdentity",
      "type": "object"
    }
  },
  "$id": "urn:vulnproof:evidence-bundle:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Assessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExecutionEvidence"
      },
      "title": "Execution Evidence",
      "type": "array"
    },
    "finding": {
      "$ref": "#/$defs/Finding"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshots": {
      "items": {
        "$ref": "#/$defs/SourceSnapshot"
      },
      "minItems": 1,
      "title": "Snapshots",
      "type": "array"
    },
    "static_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StaticEvidence"
      },
      "title": "Static Evidence",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "finding",
    "snapshots"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
